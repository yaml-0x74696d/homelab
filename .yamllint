---
extends: default

ignore: |
  ansible/collections/
  ansible/apps/proxy/traefik/dynamic/remote_services.yml

# rule values ansible-lint expects from yamllint
rules:
  document-start: disable
  line-length:
    max: 160
    level: warning
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
