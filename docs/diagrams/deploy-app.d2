# docker_app deploy flow. `just diagrams` renders it to docs/img/deploy-app.svg
# colours from likec4: blue = ansible code, slate = inputs, green (c4 accent) = target
shape: sequence_diagram
style.fill: "#18191b"   # likec4 dark canvas

classes: {
  code: {style: {fill: "#3b82f6"; stroke: "#2563eb"; font-color: "#eff6ff"}}
  input: {style: {fill: "#64748b"; stroke: "#475569"; font-color: "#f8fafc"}}
  target: {style: {fill: "#16a34a"; stroke: "#15803d"; font-color: "#f0fdf4"}}
}
(* -> *)[*].style: {
  stroke: "#94a3b8"
  stroke-width: 3
  font-color: "#f8fafc"
}

pb: "deploy-<app>.yml" {class: code}
role: "roles/docker_app" {class: code}
src: "apps/<app>/" {class: input}
facts: "group_vars/all" {class: input}
host: "docker host" {class: target}

pb -> role: "1. hosts, docker_app_* vars"
role -> host: "2. dirs, networks, touch files, ufw"
src -> role: "3. plain files, *.j2"
facts -> role: "4. facts + vault.yml secrets"
role -> host: "5. copy + render into /opt/apps/<app>/"
role -> host: "6. cifs creds (smb_passwords) + mount"
role -> host: "7. docker compose up"
role -> host: "8. restart docker_app_restart (only if config changed)" {style.stroke-dash: 4}
pb -> host: "9. post_tasks, e.g. gitea admin"
