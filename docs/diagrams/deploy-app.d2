# podman_app deploy flow. `just diagrams` renders it to docs/img/deploy-app.svg
# colours from likec4: blue = ansible code, slate = inputs, green (c4 accent) = target
shape: sequence_diagram
style.fill: "#18191b"   # likec4 dark canvas

classes: {
  code: {style: {fill: "#3b82f6"; stroke: "#2563eb"; font-color: "#eff6ff"}}
  input: {style: {fill: "#64748b"; stroke: "#475569"; font-color: "#f8fafc"}}
  target: {style: {fill: "#16a34a"; stroke: "#15803d"; font-color: "#f0fdf4"}}
}
(* -> *)[*].style: {
  stroke: "#94a3b8"
  stroke-width: 3
  font-color: "#f8fafc"
}

pb: "deploy-app.yml -e app=<app>" {class: code}
role: "roles/podman_app" {class: code}
src: "apps/<app>/" {class: input}
facts: "group_vars/all" {class: input}
host: "pod vm" {class: target}

pb -> role: "1. apps.yml entry"
facts -> role: "2. apps.yml, vault.yml, app_sources"
role -> host: "3. svc-<app> user, subuid range, linger"
src -> role: "4. units *.j2, config/, secret templates"
role -> host: "5. dirs + quadlets in ~/.config/containers/systemd"
role -> host: "6. config to /srv/apps/<app>/config, cifs mounts"
role -> host: "7. ufw rules from allow_from"
role -> host: "8. podman secrets, image pull"
role -> host: "9. restart (only if something changed), start, wait for healthy" {style.stroke-dash: 4}
role -> host: "10. auto-update timer, prune old images"
