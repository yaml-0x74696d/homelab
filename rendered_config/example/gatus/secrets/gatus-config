# managed by ansible (apps/gatus). every check comes from apps.yml and the inventory
storage:
  type: sqlite
  path: /data/data.db

# dark unless the browser asks for light (gatus lets the os preference win)
ui:
  dark-mode: true

alerting:
  ntfy:
    url: "<vault:ntfy_url>"
    topic: "<vault:ntfy_url>"
    token: "<vault:ntfy_token>"
    default-alert:
      failure-threshold: 3
      send-on-resolved: true

endpoints:
  - name: "authentik"
    group: docker-1
    url: "https://auth.example.org"
    interval: 60s
    conditions:
      - "[STATUS] < 400"
      - "[CERTIFICATE_EXPIRATION] > 168h"
    alerts:
      - type: ntfy
  - name: "gatus"
    group: docker-2
    url: "https://status.example.org"
    interval: 60s
    client:
      ignore-redirect: true
    conditions:
      - "[STATUS] == 302"
      - "[CERTIFICATE_EXPIRATION] > 168h"
    alerts:
      - type: ntfy
  - name: "gatus backend"
    group: docker-2
    url: "http://host.containers.internal:3001"
    interval: 60s
    conditions: ["[STATUS] < 400"]
    alerts:
      - type: ntfy
  - name: "gitea"
