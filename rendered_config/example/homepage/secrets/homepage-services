- VMs:
            - pod-1:
                icon: sh-debian
                proxmoxNode: pve-1
                proxmoxVMID: 201
                showStats: true
                href: https://192.168.178.201:9090/
                fields: ["cpu", "mem"]
                widget:
                    type: prometheusmetric
                    url: http://192.168.178.202:9091
                    refreshInterval: 30000
                    metrics:
                        - label: disk
                          query: 100 * (1 - node_filesystem_avail_bytes{instance="192.168.178.201:9100",mountpoint="/"} / node_filesystem_size_bytes{instance="192.168.178.201:9100",mountpoint="/"})
                          format: {type: number, suffix: "%", options: {maximumFractionDigits: 0}}
                        - label: up
                          query: time() - node_boot_time_seconds{instance="192.168.178.201:9100"}
                          format: {type: duration}

