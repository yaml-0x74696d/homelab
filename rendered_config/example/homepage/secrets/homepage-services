- Status:
        - Gatus:
            icon: sh-gatus
            href: https://status.example.org
            siteMonitor: http://192.168.178.202:3001
            widget:
                type: gatus
                url: http://192.168.178.202:3001
        - Semaphore:
            icon: sh-semaphore-ui
            href: https://semaphore.example.org
            siteMonitor: http://192.168.178.100:3000
            widget:
                type: customapi
                url: http://192.168.178.100:3000/api/project/1/tasks/last
                refreshInterval: 60000
                headers:
                    Authorization: "Bearer <vault:semaphore_gatus_token>"
                mappings:
                    - field: 0.tpl_alias
                      label: last run
                    - field: 0.status
                      label: result
                    - field: 0.end
                      label: ended
                      format: relativeDate
                      style: short


