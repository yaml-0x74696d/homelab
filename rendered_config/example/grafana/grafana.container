[Unit]
Description=grafana

[Container]
Volume=/srv/apps/grafana/data:/var/lib/grafana
Volume=/srv/apps/grafana/config/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
PublishPort=3000:3000
Secret=grafana-admin-pass,type=env,target=GF_SECURITY_ADMIN_PASSWORD
Secret=grafana-oidc-secret,type=env,target=GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET
Environment=GF_SERVER_ROOT_URL=https://grafana.example.org
Environment=GF_USERS_ALLOW_SIGN_UP=false
# oidc via authentik; local login form stays as break-glass
Environment=GF_AUTH_GENERIC_OAUTH_ENABLED=true
Environment=GF_AUTH_GENERIC_OAUTH_NAME=Authentik
Environment=GF_AUTH_GENERIC_OAUTH_CLIENT_ID=<vault:grafana_oidc_id>
Environment="GF_AUTH_GENERIC_OAUTH_SCOPES=openid email profile"
Environment=GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.example.org/application/o/authorize/
Environment=GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.example.org/application/o/token/
Environment=GF_AUTH_GENERIC_OAUTH_API_URL=https://auth.example.org/application/o/userinfo/
Environment=GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
Environment=GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
Environment=GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
# single-user box: every authentik login is org admin
Environment="GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH='Admin'"
# token exchange goes straight to traefik, container dns can't resolve auth.<domain>
AddHost=auth.example.org:192.168.178.201
HealthCmd=wget -qO /dev/null http://127.0.0.1:3000/api/health
