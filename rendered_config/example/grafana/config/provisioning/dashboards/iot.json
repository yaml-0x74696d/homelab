{
  "uid": "lab-iot",
  "title": "IoT sensors",
  "tags": [
    "lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "sensor",
        "label": "sensor",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "efkt8i31skjk0b"
        },
        "query": {
          "query": "label_values({job=\"iot_sensors\"}, sensor)",
          "refId": "v"
        },
        "definition": "label_values({job=\"iot_sensors\"}, sensor)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "temperature now",
      "datasource": {
        "type": "prometheus",
        "uid": "efkt8i31skjk0b"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efkt8i31skjk0b"
          },
          "expr": "iot_temperature_celsius{sensor=~\"$sensor\"}",
          "legendFormat": "{{sensor}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
