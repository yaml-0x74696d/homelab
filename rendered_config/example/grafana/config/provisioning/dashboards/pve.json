    {
      "id": 5,
      "type": "timeseries",
      "title": "cpu",
      "datasource": {
        "type": "prometheus",
        "uid": "efkt8i31skjk0b"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efkt8i31skjk0b"
          },
          "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{job=\"pve-hosts\",mode=\"idle\"}[5m])) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "ram",
      "datasource": {
        "type": "prometheus",
        "uid": "efkt8i31skjk0b"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "efkt8i31skjk0b"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"pve-hosts\"} / node_memory_MemTotal_bytes{job=\"pve-hosts\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
