# secrets + per-lab values
ansible/group_vars/all/vault.yml
ansible/group_vars/all/private/private.yml
.vault_pass
**/.vault_pass
.env
*.tfvars

# private keys (public keys stay on the controller too, see admin_ssh_pubkey_file)
id_ed25519*
id_rsa*
*.pem
*.key

# aide db hashes: on the controller a symlink into the offsite-synced private folder
ansible/aide

# ansible: installed collections, ansible-lint cache, run artifacts
ansible/collections/
.ansible/
**/*artifact*.json
*.log

# tofu
tofu/.terraform/
*.tfstate
*.tfstate.*
# saved plans hold every value unmasked (vm_password)
*.plan

# nix build output (symlink to the store)
nixos/result*

# likec4 build output
architecture/dist/

# tooling / editor
.claude/
.mcp.json
.idea/
.vscode/

# homepage background, personal (belongs in the private overlay, this catches a stray copy)
ansible/apps/dashboard/homepage/config/images/background.jpg
