ansible-navigator:
  execution-environment:
    container-engine: podman
    enabled: true
    image: ghcr.io/ansible/community-ansible-dev-tools:latest   # navigator default; creator-ee is archived
    pull:
      policy: missing
    # .vault_pass, vault.yml, private.yml are symlinks there; same path inside, or they dangle
    volume-mounts:
      - src: /path/to/private
        dest: /path/to/private
        options: ro

  playbook-artifact:
    enable: true
    save-as: "{playbook_name}-artifact-{time_stamp}.json"
