TZ={{ timezone }}

# how often to check for new image digests (cron)
DIUN_SCHEDULE={{ diun_schedule }}
DIUN_JITTER={{ diun_jitter }}
DIUN_NTFY_PRIORITY={{ diun_ntfy_priority }}

# split the shared ntfy_url (https://ntfy.sh/<topic>) into endpoint + topic
NTFY_ENDPOINT={{ ntfy_url | regex_replace('/[^/]+$', '') }}
NTFY_TOPIC={{ ntfy_url | regex_replace('^.*/', '') }}
NTFY_TOKEN={{ ntfy_token | default('') }}
