INFLUXDB_TAG={{ influxdb_tag }}
PORT={{ app_ports.influxdb }}
TZ={{ timezone }}
INFLUX_USER={{ admin_user }}
INFLUX_PASSWORD={{ influxdb_admin_pass }}
INFLUX_ORG={{ influxdb_org }}
INFLUX_BUCKET={{ influxdb_bucket }}
# admin token — grafana + HA authenticate with this (keep alphanumeric, compose eats $)
INFLUX_TOKEN={{ influxdb_admin_token }}
