{% set uid = (podman_app_entry.dirs | selectattr('path', 'eq', 'data') | first).owner %}
[Unit]
Description=semaphore

[Container]
Volume={{ podman_app_dir }}/data:/var/lib/semaphore
# same path as on the host, the ui's repository points here. ansible.cfg sits in ansible/
Volume={{ semaphore_repo_dir }}:{{ semaphore_repo_dir }}:ro
# ctl-1's copy of private_dir (roles/ctl_base), the app roles' overlay
Volume={{ semaphore_private_dir }}:{{ semaphore_private_dir }}:ro
Volume={{ podman_app_dir }}/aide:{{ semaphore_aide_dir }}
# host network: ansible has to reach ctl-1's own sshd, pasta would hand ctl1_ip back to the container.
# so semaphore listens on apps.yml's port straight on the host
Network=host
Environment=SEMAPHORE_PORT=:{{ podman_app_entry.port }}
Secret=semaphore-admin-pass,type=mount,target=/run/secrets/admin-pass,uid={{ uid }},mode=0400
Secret=semaphore-key-encryption,type=mount,target=/run/secrets/key-encryption,uid={{ uid }},mode=0400
Secret=semaphore-oidc,type=env,target=SEMAPHORE_OIDC_PROVIDERS
Environment=SEMAPHORE_ADMIN_PASSWORD_FILE=/run/secrets/admin-pass
Environment=SEMAPHORE_ACCESS_KEY_ENCRYPTION_FILE=/run/secrets/key-encryption
Environment=SEMAPHORE_ADMIN={{ semaphore_admin_user }}
Environment=SEMAPHORE_DB_DIALECT=sqlite
Environment=SEMAPHORE_WEB_ROOT=https://semaphore.{{ domain }}
Environment=SEMAPHORE_SCHEDULE_TIMEZONE={{ timezone }}
Environment=TZ={{ timezone }}
# roles/aide reads and writes the hashes here instead of the read-only checkout
Environment=AIDE_CHECKSUM_DIR={{ semaphore_aide_dir }}
# semaphore runs ansible from playbooks/, so it wouldn't find ansible.cfg on its own
Environment=ANSIBLE_CONFIG={{ semaphore_repo_dir }}/ansible/ansible.cfg
# private.yml's private_dir (~/...) would expand to the container user's home here
Environment=HOMELAB_PRIVATE_DIR={{ semaphore_private_dir }}
# tasks only get the env vars listed here. single quotes keep the json quotes past systemd's parser
Environment='SEMAPHORE_FORWARDED_ENV_VARS=["AIDE_CHECKSUM_DIR", "ANSIBLE_CONFIG", "HOMELAB_PRIVATE_DIR"]'
# token exchange goes straight to traefik, container dns can't resolve auth.<domain>
AddHost=auth.{{ domain }}:{{ app_sources.edge }}
HealthCmd=wget -qO /dev/null http://127.0.0.1:{{ podman_app_entry.port }}/api/ping
