DOMAIN={{ domain }}
PORT={{ app_ports.nextcloud }}
PG_TAG={{ nextcloud_pg_tag }}
PG_PASS={{ nextcloud_db_pass }}
NC_ADMIN_USER={{ admin_user }}
NC_ADMIN_PASS={{ nextcloud_admin_pass }}
# traefik/authentik live on docker-1; container dns doesn't know internal names, so pin it (oidc calls auth server-side)
DOCKER1_IP={{ docker1_ip }}

DATA_PATH={{ nextcloud_data_path }}
SHARES_ROOT={{ cifs_mount_root }}
PHP_MEMORY_LIMIT={{ nextcloud_php_memory_limit }}
PHP_UPLOAD_LIMIT={{ nextcloud_php_upload_limit }}

HEALTH_INTERVAL={{ nextcloud_health_interval }}
HEALTH_RETRIES={{ nextcloud_health_retries }}
HEALTH_START={{ nextcloud_health_start }}
DB_HEALTH_TIMEOUT={{ nextcloud_db_health_timeout }}
REDIS_HEALTH_TIMEOUT={{ nextcloud_redis_health_timeout }}
