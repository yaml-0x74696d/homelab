DOMAIN={{ domain }}
USER_UID={{ gitea_uid }}
USER_GID={{ gitea_uid }}
GITEA_SSH_PORT={{ gitea_ssh_port }}
GITEA__server__DOMAIN=git.{{ domain }}
GITEA__server__ROOT_URL=https://git.{{ domain }}/
GITEA__server__SSH_DOMAIN=git.{{ domain }}
GITEA__server__SSH_PORT={{ gitea_ssh_port }}
GITEA__server__START_SSH_SERVER=false
GITEA__database__DB_TYPE=sqlite3
GITEA__service__DISABLE_REGISTRATION=true
GITEA__security__INSTALL_LOCK=true

# oidc login: source itself is added once via `gitea admin auth add-oauth` (see docs/tier1-oidc.md).
# these just control mapping — auto-create oidc accounts, name them by the authentik username,
# and link to the existing local account with the same email instead of duplicating it.
GITEA__oauth2_client__ENABLE_AUTO_REGISTRATION=true
GITEA__oauth2_client__USERNAME=preferred_username
GITEA__oauth2_client__ACCOUNT_LINKING=auto

# homelab theme lives in data/gitea/public/assets/css
GITEA__ui__THEMES=homelab,gitea-auto,gitea-dark,gitea-light
GITEA__ui__DEFAULT_THEME=homelab
PORT={{ app_ports.gitea }}
