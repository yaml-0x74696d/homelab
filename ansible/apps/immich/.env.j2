IMMICH_VERSION=release
UPLOAD_LOCATION={{ immich_photos_path }}
HOST_PORT={{ app_ports.immich }}
REDIS_TAG={{ immich_redis_tag }}
PG_TAG={{ immich_pg_tag }}
DB_HOSTNAME=database
DB_USERNAME=immich
DB_DATABASE_NAME=immich
DB_PASSWORD={{ immich_db_pass }}
REDIS_HOSTNAME=redis
TZ={{ timezone }}
HEALTH_INTERVAL={{ immich_health_interval }}
HEALTH_RETRIES={{ immich_health_retries }}
HEALTH_START={{ immich_health_start }}
DB_HEALTH_TIMEOUT={{ immich_db_health_timeout }}
REDIS_HEALTH_TIMEOUT={{ immich_redis_health_timeout }}
# oidc: reach authentik via traefik on docker-1 (container dns can't resolve internal names)
DOMAIN={{ domain }}
DOCKER1_IP={{ docker1_ip }}
# ml disabled by choice — no smart search / face recognition, no model downloads
IMMICH_MACHINE_LEARNING_ENABLED=false
