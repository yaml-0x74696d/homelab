# image, pod, house rules: drop-ins from roles/podman_app
[Unit]
Description=searxng cache (limiter counters)

[Container]
Volume={{ podman_app_dir }}/valkey:/data:Z
# snapshot after 30s if at least one key changed
Exec=valkey-server --save "30 1" --loglevel warning
HealthCmd=sh -c 'valkey-cli ping | grep -q PONG'
