# managed by ansible (apps/dashboard). route names straight to traefik, like gatus' AddHost=:
# the badges must not depend on dns inside the container (it can't resolve them)
{% set hosts = [] %}
{% for app in apps.values() if app.state | default('present') == 'present' %}
{% for r in app.routes | default([]) %}
{% set _ = hosts.append(r.host) %}
{% endfor %}
{% endfor %}
{% for r in infra_routes %}
{% set _ = hosts.append(r.host) %}
{% endfor %}
services:
  homepage:
    extra_hosts:
{% for h in hosts | unique | sort %}
      - "{{ h }}.{{ domain }}:{{ app_sources.edge }}"
{% endfor %}
