---
- Quickaccess:
    - Nextcloud:
        icon: nextcloud
        href: https://cloud.{{ domain }}
        server: docker-3
        container: nextcloud
    - Immich:
        icon: /images/immich.png
        href: https://photo.{{ domain }}
        server: docker-3
        container: immich_server
    - Jellyfin:
        icon: jellyfin
        href: https://media.{{ domain }}
        server: docker-3
        container: jellyfin
    - Vaultwarden:
        icon: /images/vaultwarden.png
        href: https://vault.{{ domain }}
        server: docker-1
        container: vaultwarden
    - FritzBoX:
        icon: fritzbox
        href: https://{{ gateway_ip }}
        ping: {{ homepage_ping_target }}

- Services:
        # edge & access
        - Traefik:
            icon: /images/traefik.png
            href: https://proxy.{{ domain }}
            showStats: true
            server: docker-1
            container: traefik
        - Authentik:
            icon: authentik
            href: https://auth.{{ domain }}
            showStats: true
            server: docker-1
            container: authentik-server
        - Pi-hole:
            icon: /images/pihole.png
            href: https://dns.{{ domain }}/admin/login
            showStats: true
            server: docker-2
            container: pihole
        - Cloudflare DDNS:
            icon: cloudflare
            showStats: true
            server: docker-1
            container: cloudflare-ddns
        - Nginx Web:
            icon: nginx
            href: https://web.{{ domain }}
            siteMonitor: http://{{ hostvars[apps['nginx'].host].ansible_host }}:{{ apps['nginx'].port }}
        # monitoring & dashboards
        - Prometheus:
            icon: prometheus
            href: https://prom.{{ domain }}
            showStats: true
            server: docker-2
            container: prometheus
        - Grafana:
            icon: grafana
            href: https://grafana.{{ domain }}
            showStats: true
            server: docker-2
            container: grafana
        - InfluxDB:
            icon: influxdb
            href: https://influx.{{ domain }}
            showStats: true
            server: docker-2
            container: influxdb
        - Gatus:
            icon: gatus
            href: https://status.{{ domain }}
            siteMonitor: http://{{ hostvars[apps['gatus'].host].ansible_host }}:{{ apps['gatus'].port }}
            widget:
                type: gatus
                url: http://{{ hostvars[apps['gatus'].host].ansible_host }}:{{ apps['gatus'].port }}
        - Homepage:
            icon: homepage
            href: https://home.{{ domain }}
            showStats: true
            server: docker-1
            container: homepage
        # home & iot
        - Home Assistant:
            icon: /images/homeassistant.png
            href: https://ha.{{ domain }}
            showStats: true
            server: docker-1
            container: homeassistant
        - ESPHome:
            icon: esphome
            href: https://esphome.{{ domain }}
            showStats: true
            server: docker-1
            container: esphome
        - MQTT Broker:
            icon: mdi-access-point-network
            showStats: true
            server: docker-1
            container: mosquitto
        - MQTT Exporter:
            icon: mdi-transmission-tower
            showStats: true
            server: docker-1
            container: mqtt-exporter
        # apps & utilities
        - Gitea:
            icon: gitea
            href: https://git.{{ domain }}
            showStats: true
            server: docker-1
            container: gitea
        - Paperless:
            icon: paperless-ngx
            href: https://paperless.{{ domain }}
            showStats: true
            server: docker-3
            container: paperless
        - SearXNG:
            icon: searxng
            href: https://search.{{ domain }}
            showStats: true
            server: docker-1
            container: searxng
        - PDFcraft:
            icon: /images/pdfcraft.png
            href: https://pdf.{{ domain }}
            showStats: true
            server: docker-1
            container: pdfcraft

- Servers:
        - PVE-1:
            icon: proxmox
            href: https://pve-1.{{ domain }}
            ping: {{ pve1_ip }}
            widget:
                type: proxmox
                url: https://{{ pve1_ip }}:{{ pve_ui_port }}
                username: {{ homepage_pve_token_id }}
                password: "{{ proxmox_secret }}"
                node: pve-1
                fields: ["resources.cpu", "resources.mem"]
        - PVE-2:
            icon: proxmox
            href: https://pve-2.{{ domain }}
            ping: {{ pve2_ip }}
            widget:
                type: proxmox
                url: https://{{ pve2_ip }}:{{ pve_ui_port }}
                username: {{ homepage_pve_token_id }}
                password: "{{ proxmox_secret }}"
                node: pve-2
                fields: ["resources.cpu", "resources.mem"]
        - PVE-3:
            icon: proxmox
            href: https://pve-3.{{ domain }}
            ping: {{ pve3_ip }}
            widget:
                type: proxmox
                url: https://{{ pve3_ip }}:{{ pve_ui_port }}
                username: {{ homepage_pve_token_id }}
                password: "{{ proxmox_secret }}"
                node: pve-3
                fields: ["resources.cpu", "resources.mem"]
        - PBS:
            icon: proxmox-backup-server
            href: https://pbs.{{ domain }}
            ping: {{ pve3_ip }}
            widget:
                type: proxmoxbackupserver
                url: https://{{ pve3_ip }}:{{ pbs_port }}
                username: {{ homepage_pbs_token_id }}
                password: "{{ pbs_homepage_token | default('') }}"
                fields: ["datastore_usage", "failed_tasks_24h"]

- VM:
            - docker-1:
                icon: /images/debian.png
                proxmoxNode: pve-1
                proxmoxVMID: {{ vmids.docker1 }}
                showStats: true
                href: https://{{ docker1_ip }}:{{ cockpit_port }}/
                fields: ["cpu", "mem"]
            - docker-2:
                icon: /images/debian.png
                proxmoxNode: pve-2
                proxmoxVMID: {{ vmids.docker2 }}
                showStats: true
                href: https://{{ docker2_ip }}:{{ cockpit_port }}/
                fields: ["cpu", "mem"]
            - docker-3:
                icon: /images/debian.png
                proxmoxNode: pve-3
                proxmoxVMID: {{ vmids.docker3 }}
                showStats: true
                href: https://{{ docker3_ip }}:{{ cockpit_port }}/
                fields: ["cpu", "mem"]
            - netbird:
                icon: netbird
                proxmoxNode: pve-2
                proxmoxVMID: {{ vmids.netbird }}
                showStats: true
                href: https://nb.{{ domain }}
                fields: ["cpu", "mem"]
            - storage:
                icon: /images/lxc.png
                # showStats hits qemu/<vmid> for this lxc and 500s; query the lxc path directly
                widget:
                    type: customapi
                    url: https://{{ pve3_ip }}:{{ pve_ui_port }}/api2/json/nodes/pve-3/lxc/{{ vmids.storage }}/status/current
                    method: GET
                    headers:
                        Authorization: "PVEAPIToken={{ homepage_pve_token_id }}={{ proxmox_secret }}"
                    mappings:
                        - field: data.cpu
                          label: CPU
                          format: percent
                        - field: data.mem
                          label: MEM
                          format: bytes
            - log:
                icon: /images/lxc.png
                widget:
                    type: customapi
                    url: https://{{ pve3_ip }}:{{ pve_ui_port }}/api2/json/nodes/pve-3/lxc/{{ vmids.log }}/status/current
                    method: GET
                    headers:
                        Authorization: "PVEAPIToken={{ homepage_pve_token_id }}={{ proxmox_secret }}"
                    mappings:
                        - field: data.cpu
                          label: CPU
                          format: percent
                        - field: data.mem
                          label: MEM
                          format: bytes
