DOMAIN={{ domain }}
LOG_LEVEL={{ traefik_log_level }}

ACME_EMAIL={{ acme_email }}
ACME_RESOLVERS={{ traefik_acme_resolvers }}
CF_DNS_API_TOKEN={{ cf_token }}

PVE1_IP={{ pve1_ip }}
PVE2_IP={{ pve2_ip }}
PVE3_IP={{ pve3_ip }}
POD1_IP={{ pod1_ip }}
POD2_IP={{ pod2_ip }}
POD3_IP={{ pod3_ip }}
HAOS_IP={{ haos_ip }}
CTL1_IP={{ ctl1_ip }}

# backend ports for the file provider (remote_services.yml)
PVE_UI_PORT={{ pve_ui_port }}
PBS_PORT={{ pbs_port }}
{% for app, port in app_ports.items() %}
{{ app | upper }}_PORT={{ port }}
{% endfor %}
