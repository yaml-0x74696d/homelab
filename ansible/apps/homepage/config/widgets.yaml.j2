---
# info row, left to right
- datetime:
    text_size: xl
    locale: en-GB   # dd/mm/yyyy
    format:
      dateStyle: short
      timeStyle: short
      hourCycle: h23
- search:
    provider: custom
    url: https://{{ apps.searxng.routes[0].host }}.{{ domain }}/search?q=
    target: _blank
    focus: true
- openmeteo:
    label: {{ homepage_weather_label }}
    latitude: {{ homepage_weather_latitude }}
    longitude: {{ homepage_weather_longitude }}
    timezone: {{ timezone }}
    units: metric
    cache: 5
