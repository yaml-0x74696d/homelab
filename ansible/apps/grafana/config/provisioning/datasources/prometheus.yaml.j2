# managed by ansible (apps/grafana). uid kept from the click-made one, dashboards point at it
apiVersion: 1
datasources:
  - name: prometheus
    uid: efkt8i31skjk0b
    type: prometheus
    access: proxy
    url: "http://{{ 'host.containers.internal' if apps['prometheus'].host == apps['grafana'].host else hostvars[apps['prometheus'].host].ansible_host }}:{{ apps['prometheus'].port }}"
    isDefault: true
    editable: false
