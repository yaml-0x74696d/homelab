DOMAIN={{ domain }}
PORT={{ app_ports.homelable }}

# single-quote it — bcrypt $ breaks compose interpolation
AUTH_PASSWORD_HASH='{{ homelable_hash }}'
SECRET_KEY={{ homelable_key }}
AUTH_USERNAME={{ homelable_user }}
SCANNER_RANGES=["{{ lan_cidr }}"]

HEALTH_INTERVAL={{ homelable_health_interval }}
HEALTH_TIMEOUT={{ homelable_health_timeout }}
HEALTH_RETRIES={{ homelable_health_retries }}
HEALTH_START={{ homelable_health_start }}
