DOMAIN={{ domain }}
VAULTWARDEN_TAG={{ vaultwarden_tag }}
# argon2 phc string; single quotes keep its $ away from compose interpolation
ADMIN_TOKEN='{{ vw_admin }}'
SIGNUPS_ALLOWED=false
SSO_AUTHORITY=https://auth.{{ domain }}/application/o/vaultwarden/
SSO_CLIENT_ID={{ vw_sso_id }}
SSO_CLIENT_SECRET={{ vw_sso_secret }}
SSO_SCOPES=email profile offline_access
PORT={{ app_ports.vaultwarden }}
