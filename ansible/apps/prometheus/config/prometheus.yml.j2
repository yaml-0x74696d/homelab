{# prometheus' own host: a pasta container can't reach the vm's own ip, host.containers.internal it is #}
{% macro addr(host, ip) %}{{ 'host.containers.internal' if host == apps['prometheus'].host else ip }}{% endmacro %}
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'pve-hosts'
    static_configs:
      - targets:
          - '{{ pve1_ip }}:{{ node_exporter_port }}'
          - '{{ pve2_ip }}:{{ node_exporter_port }}'
          - '{{ pve3_ip }}:{{ node_exporter_port }}'

  - job_name: 'node-exporter'
    static_configs:
      - targets:
          - '{{ addr('pod-1', pod1_ip) }}:{{ node_exporter_port }}'
          - '{{ addr('pod-2', pod2_ip) }}:{{ node_exporter_port }}'
          - '{{ addr('pod-3', pod3_ip) }}:{{ node_exporter_port }}'
{% for h in groups['lxc_containers'] + groups['podman_hosts'] %}
          - '{{ hostvars[h].ansible_host }}:{{ node_exporter_port }}'
{% endfor %}

  - job_name: 'docker-engines'
    static_configs:
      - targets:
          - '{{ addr('pod-1', pod1_ip) }}:{{ docker_metrics_port }}'
          - '{{ addr('pod-2', pod2_ip) }}:{{ docker_metrics_port }}'

  - job_name: 'iot_sensors'
    scrape_interval: {{ prometheus_scrape_interval }}
    static_configs:
      - targets: ['{{ iot_lan_ip }}:{{ mqtt_exporter_port }}']
