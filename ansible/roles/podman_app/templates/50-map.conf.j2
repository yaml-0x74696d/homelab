# managed by ansible (roles/podman_app), from apps.yml: {{ podman_app_name }} / {{ item.name }}
[Container]
ContainerName={{ item.name }}
Image={{ item.image }}:{{ item.tag }}
{% if item.auto_update | default(true) %}
AutoUpdate=registry
{% endif %}
{% if item.user is defined %}
User={{ item.user }}
{% endif %}
StopTimeout={{ item.stop_timeout | default(podman_app_stop_timeout) }}
{% if not item.healthcheck | default(true) %}
Notify=false
{% endif %}
NoNewPrivileges={{ item.no_new_privileges | default(true) | lower }}
{% if item.read_only | default(false) %}
ReadOnly=true
{% endif %}
{% for cap in item.drop_caps | default([]) %}
DropCapability={{ cap }}
{% endfor %}
{% for cap in item.add_caps | default([]) %}
AddCapability={{ cap }}
{% endfor %}
