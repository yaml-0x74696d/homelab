{# one rule per port and source, rendered as yaml. names: app_sources first, else another app's host ip.
   edge also gets ingress_extra_sources (parallel run before the edge cutover) #}
{% set ports = ([{'port': podman_app_entry.port, 'proto': 'tcp', 'allow_from': podman_app_entry.allow_from}] if podman_app_entry.port is defined else [])
               + podman_app_entry.extra_ports | default([]) %}
{% for p in ports %}
{% for name in p.allow_from %}
{% set main = app_sources[name] if name in app_sources else hostvars[apps[name].host].ansible_host %}
{% for src in [main] + (ingress_extra_sources | default([]) if name == 'edge' else []) %}
- port: {{ p.port }}
  proto: {{ p.proto | default('tcp') }}
  src: "{{ src }}"
{% endfor %}
{% endfor %}
{% endfor %}
