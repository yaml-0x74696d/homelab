# managed by ansible (roles/pve_firewall) — iot gateway lxc, lan leg. inbound = the ufw inside, egress only here.
# the iot net is on the ct's wifi card, not a pve nic, so only the ufw inside filters it
[OPTIONS]

enable: 1
ipfilter: 1
policy_in: DROP
policy_out: DROP

[RULES]

# lan: the consumers, scrapes, ssh, ping
{% for h in pve_firewall_iot_mqtt_clients %}
IN ACCEPT -source {{ h.ip }} -p tcp -dport {{ mqtt_port }} -log nolog # {{ h.c }}
{% endfor %}
IN ACCEPT -source {{ pve_firewall_prometheus_ip }} -p tcp -dport {{ mqtt_exporter_port }} -log nolog
IN ACCEPT -source {{ pve_firewall_prometheus_ip }} -p tcp -dport {{ node_exporter_port }} -log nolog
IN ACCEPT -source {{ pve_firewall_lan_cidr }} -p tcp -dport {{ ssh_port }} -log nolog
IN ACCEPT -source {{ pve_firewall_lan_cidr }} -p icmp -log nolog

# egress: dns to the router (what tofu set as resolver), relp to the log lxc,
# http/https to the internet (apt, ntfy). nothing else, the rest of the lan stays shut
OUT ACCEPT -dest {{ pve_firewall_gateway_ip }} -p udp -dport 53 -log nolog
OUT ACCEPT -dest {{ pve_firewall_gateway_ip }} -p tcp -dport 53 -log nolog
OUT ACCEPT -dest {{ pve_firewall_log_ip }} -p tcp -dport {{ pve_firewall_log_port }} -log nolog
OUT DROP -dest {{ pve_firewall_lan_cidr }} -log nolog
OUT ACCEPT -p tcp -dport 80 -log nolog
OUT ACCEPT -p tcp -dport 443 -log nolog
