#!/usr/bin/env python3
"""Every app container on this host and the newest tag upstream, one json object per line.

Run by roles/app_versions through the script module, nothing stays on the host. Stdlib only.
  app-versions <host> <svc prefix> <svc group> <lookup timeout>
status: current, update (a floating tag moved upstream), newer (a pinned tag has a newer one), unknown
"""
import functools
import grp
import json
import pwd
import re
import subprocess
import sys

LABEL = "org.opencontainers.image.version"
RELEASE = r"v?\d+(?:\.\d+){1,2}"


def run(*cmd, user=None):
    """stdout, or None when the command fails"""
    if user:
        uid = pwd.getpwnam(user).pw_uid
        cmd = ("sudo", "-u", user, f"XDG_RUNTIME_DIR=/run/user/{uid}", *cmd)
    # cwd /: the svc users can't enter the caller's dir
    p = subprocess.run(cmd, capture_output=True, text=True, cwd="/", stdin=subprocess.DEVNULL)
    return p.stdout if p.returncode == 0 else None


def version_key(v):
    """like sort -V: 1.10 after 1.9"""
    return [int(x) if x.isdigit() else x for x in re.split(r"(\d+)", v.removeprefix("v"))]


def newest(tags, pattern):
    found = [t for t in tags if re.fullmatch(pattern, t)]
    return max(found, key=version_key) if found else ""


def main(host, prefix, group, timeout):
    @functools.cache
    def tags(repo):
        out = run("skopeo", "list-tags", "--command-timeout", timeout, f"docker://{repo}")
        return json.loads(out)["Tags"] if out else []

    @functools.cache
    def digest(ref):
        out = run("skopeo", "inspect", "--no-tags", "--command-timeout", timeout,
                  "--format", "{{.Digest}}", f"docker://{ref}")
        return out.strip() if out else ""

    for user in sorted(grp.getgrnam(group).gr_mem):
        for c in json.loads(run("podman", "ps", "--format", "json", user=user) or "[]"):
            ref = c["Image"]
            if ref.startswith("localhost/"):   # pod pause containers, built locally
                continue
            repo, _, tag = ref.rpartition(":")
            image = json.loads(run("podman", "image", "inspect", c["ImageID"], user=user) or "[{}]")[0]
            running = (image.get("Labels") or {}).get(LABEL, "")
            running_digests = {d.partition("@")[2] for d in image.get("RepoDigests") or []}
            status = "unknown"

            if re.search(r"\d", tag):
                # pinned: same shape as the tag, 16-alpine finds 17-alpine, not 17-bookworm
                top = newest(tags(repo), re.sub(r"\d+", r"\\d+", re.escape(tag)))
                if top:
                    status = "newer" if version_key(top) > version_key(tag) else "current"
            else:
                # floating: newest release with the same suffix (alpine -> 1.2.3-alpine), else plain releases
                top = newest(tags(repo), f"{RELEASE}-{re.escape(tag)}") or newest(tags(repo), RELEASE)
                if remote := digest(ref):
                    status = "current" if remote in running_digests else "update"
                # no label: the running image is the newest release if their digests match
                if not running and top and digest(f"{repo}:{top}") in running_digests:
                    running = top

            print(json.dumps({
                "host": host, "app": user.removeprefix(prefix), "container": c["Names"][0],
                "repo": repo, "tag": tag, "running": running, "built": image.get("Created", "")[:10],
                "newest": top, "status": status,
            }))


if __name__ == "__main__":
    main(*sys.argv[1:5])
