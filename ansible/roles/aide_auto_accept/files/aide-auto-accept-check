#!/usr/bin/env python3
"""Can this host's AIDE changes be accepted without a person looking? Stdlib only.

Run by roles/aide_auto_accept, nothing stays on the host. The `aide --update` report comes on stdin,
the answer is one json object on stdout: {"accept": bool, "reasons": [...], "paths": n, "packages": [...]}.
Accept only if every changed path is owned by a package, that package was upgraded (or installed from a
configured repo) since the last accept, it verifies clean (dpkg --verify / rpm -V) and the changed
entries only differ in content or times: a perm, owner, link, acl or xattr change always refuses.
  aide-auto-accept-check --since EPOCH [--db-file PATH]... [--ignore REGEX]... [--max-paths N] [--removed-ok]
--since is the accept time the controller recorded, empty refuses. --ignore is a regex, matched in full.
--db-file is the package manager's own db: no owner, explained when any package qualified since the accept.
"""
import argparse
import glob
import gzip
import json
import os
import re
import shutil
import subprocess
import sys
import time

SECTION = re.compile(r"^(Added|Removed|Changed) entries:\s*$")
COUNT = re.compile(r"^\s*(Added|Removed|Changed) entries:\s+(\d+)")
ENTRY = re.compile(r"^[A-Za-z!=<>+\-. ]+: (/.*)$")
DPKG_LOG = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) (install|upgrade) (\S+) ")
# detailed section: "File: /path", then "  Attr   : old | new"
DETAIL_HEAD = re.compile(r"^(?:File|Directory|Link|Block device|Character device|FIFO|Socket|Door|Port): (/.*)$")
DETAIL_ATTR = re.compile(r"^\s+([A-Za-z][A-Za-z0-9 ]*?)\s*: ")
# what an upgrade may change: content and times. everything else (perm, uid, gid, link target, linkcount, acl,
# xattr, selinux, file type) is somebody's decision
SAFE_ATTR = re.compile(r"^(size|bcount|mtime|ctime|atime|inode|md5|sha\d+|sha3-\d+|rmd160|tiger|whirlpool|crc32b?|haval|gost|stribog\d+|blake2\w*)$", re.I)
# dpkg's per-package files, <pkg>[:arch].<ext>
DPKG_INFO = re.compile(r"^/var/lib/dpkg/info/([^/:]+)(?::[A-Za-z0-9-]+)?\.(?:list|md5sums|conffiles|triggers|shlibs|symbols|templates|config|preinst|postinst|prerm|postrm|clilibs)$")


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=900, check=False)


def parse(report):
    """paths per kind, whether the sections add up to the counts in the summary, attributes per changed path"""
    paths = {"Added": [], "Removed": [], "Changed": []}
    counts, kind, details, cur, detailed = {}, None, {}, None, False
    for line in report.splitlines():
        if line.startswith("Detailed information"):
            detailed = True
        if detailed:
            m = DETAIL_HEAD.match(line)
            if m:
                cur = details.setdefault(m.group(1), [])
                continue
            m = DETAIL_ATTR.match(line)
            if m and cur is not None:
                cur.append(m.group(1).strip())
            continue
        m = COUNT.match(line)
        if m:
            counts[m.group(1)] = int(m.group(2))
        m = SECTION.match(line)
        if m:
            kind = m.group(1)
            continue
        m = ENTRY.match(line)
        if kind and m:
            paths[kind].append(m.group(1))
    return paths, all(counts.get(k, 0) == len(v) for k, v in paths.items()), details


def candidates(path):
    """the path, then the same one with its dir resolved (merged /usr: /bin/x is /usr/bin/x)"""
    real = os.path.join(os.path.realpath(os.path.dirname(path)), os.path.basename(path))
    return [path] if real == path else [path, real]


class Debian:
    name = "dpkg"

    @staticmethod
    def norm(pkg):
        return pkg.split(":")[0]

    def owners(self, path):
        m = DPKG_INFO.match(path)
        if m:
            return {m.group(1)}
        for p in candidates(path):
            glob_safe = re.sub(r"([*?\[\]\\])", r"\\\1", p)
            r = run("dpkg-query", "-S", "--", glob_safe)
            if r.returncode == 0:
                found = set()
                for line in r.stdout.splitlines():
                    if not line.startswith("diversion by"):
                        found.update(self.norm(x.strip()) for x in line.rpartition(": ")[0].split(","))
                return found
        return set()

    def touched(self, since):
        """(upgraded, installed) since: dpkg.log, rotated files too. It also has dpkg -i and unattended-upgrades"""
        up, inst = set(), set()
        for f in glob.glob("/var/log/dpkg.log*"):
            if os.path.getmtime(f) < since:
                continue
            opener = gzip.open if f.endswith(".gz") else open
            with opener(f, "rt", errors="replace") as fh:
                for line in fh:
                    m = DPKG_LOG.match(line)
                    if m and time.mktime(time.strptime(m.group(1), "%Y-%m-%d %H:%M:%S")) > since:
                        (up if m.group(2) == "upgrade" else inst).add(self.norm(m.group(3)))
        return up, inst - up

    def from_repo(self, pkg):
        """the installed version is offered by a configured repo, not only by /var/lib/dpkg/status"""
        r = run("apt-cache", "policy", pkg)
        on, origins = False, []
        for line in r.stdout.splitlines():
            if re.match(r"^ \*\*\* ", line):
                on = True
            elif re.match(r"^ {1,5}\S", line):
                on = False
            elif on:
                m = re.match(r"^\s+\d+\s+(\S.*)$", line)
                if m and not m.group(1).startswith("/var/lib/dpkg/status"):
                    origins.append(m.group(1))
        return bool(origins)

    def clean(self, pkg):
        # dpkg --verify says nothing for a package without md5sums, so that counts as unverifiable
        sums = glob.glob(f"/var/lib/dpkg/info/{pkg}.md5sums") + glob.glob(f"/var/lib/dpkg/info/{pkg}:*.md5sums")
        if not sums:
            return "no checksums to verify against"
        r = run("dpkg", "--verify", pkg)
        return None if r.returncode == 0 and not r.stdout.strip() else f"{len(r.stdout.splitlines())} file(s) differ from the package"


class Redhat:
    name = "rpm"

    def owners(self, path):
        for p in candidates(path):
            r = run("rpm", "-qf", "--qf", "%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\\n", p)
            if r.returncode == 0:
                return set(r.stdout.split())
        return set()

    def touched(self, since):
        """rpm can't tell an upgrade from an install: everything counts as an install and needs a repo"""
        r = run("rpm", "-qa", "--qf", "%{INSTALLTIME} %{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\\n")
        return set(), {n for t, n in (l.split() for l in r.stdout.splitlines()) if int(t) > since}

    def from_repo(self, pkg):
        r = run("dnf", "-q", "repoquery", "--installed", "--qf", "%{from_repo}", pkg)
        origin = r.stdout.strip()
        return r.returncode == 0 and origin not in ("", "@commandline", "@System", "unknown")

    def clean(self, pkg):
        r = run("rpm", "-V", pkg)
        return None if r.returncode == 0 and not r.stdout.strip() else f"{len(r.stdout.splitlines())} file(s) differ from the package"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--since", default="")
    ap.add_argument("--db-file", action="append", default=[])
    ap.add_argument("--ignore", action="append", default=[])
    ap.add_argument("--max-paths", type=int, default=500)
    ap.add_argument("--removed-ok", action="store_true")
    args = ap.parse_args()

    reasons, packages, db_seen = [], set(), False

    def out(accept, total=0):
        print(json.dumps({"accept": accept and not reasons, "reasons": reasons, "paths": total, "packages": sorted(packages)}))

    # read the whole report first: exiting early with stdin unread breaks ansible's pipe on a big report
    report = sys.stdin.read()
    if not args.since.strip().isdigit():
        reasons.append("no accept time recorded for this host, accept once by hand (aide-accept.yml) first")
        return out(False)
    since = int(args.since)

    paths, consistent, details = parse(report)
    total = sum(len(v) for v in paths.values())
    if total == 0 or not consistent:
        reasons.append("couldn't read the changed paths from the report")
        return out(False, total)
    if total > args.max_paths:
        reasons.append(f"{total} changed paths, more than {args.max_paths}")
        return out(False, total)

    pm = Debian() if shutil.which("dpkg-query") else Redhat() if shutil.which("rpm") else None
    if pm is None:
        reasons.append("no dpkg and no rpm on this host")
        return out(False, total)

    upgraded, installed = pm.touched(since)
    ignore = [re.compile(x) for x in args.ignore]
    cache, repo = {}, {}

    def owners(p):
        if p not in cache:
            cache[p] = pm.owners(p)
        return cache[p]

    def counts(pkg):
        """upgraded since the last accept, or installed from a configured repo"""
        if pkg in upgraded:
            return True
        if pkg in installed:
            if pkg not in repo:
                repo[pkg] = pm.from_repo(pkg)
            return repo[pkg]
        return False

    for kind, plist in paths.items():
        for p in plist:
            if any(rx.fullmatch(p) for rx in ignore):
                continue
            if kind == "Changed":
                if p not in details:
                    reasons.append(f"no detail in the report, attributes unknown: {p}")
                    continue
                bad = sorted({a for a in details[p] if not SAFE_ATTR.match(a)})
                if bad:
                    reasons.append(f"{', '.join(bad)} changed, not just content or times: {p}")
                    continue
            if p in args.db_file:
                # the db changes with every package change: explained if a package qualified, the attribute rule was applied above
                if any(counts(pkg) for pkg in upgraded | installed):
                    db_seen = True
                else:
                    reasons.append(f"package db changed but no package was upgraded or installed from a repo since the last accept: {p}")
                continue
            isdir = os.path.isdir(p) and not os.path.islink(p)
            who = owners(p)
            if kind == "Removed" and not who:
                # no owner left. its dir's owner has to explain it, if that is allowed
                if not args.removed_ok:
                    reasons.append(f"removed, no package to check: {p}")
                    continue
                who = owners(os.path.dirname(p))
                if not {w for w in who if counts(w)}:
                    reasons.append(f"removed, its dir's owner wasn't upgraded since the last accept: {p}")
                continue
            if not who:
                reasons.append(f"not owned by a package: {p}")
                continue
            ok = {w for w in who if counts(w)}
            if isdir and not ok and p.startswith("/var/lib/dpkg") and (upgraded | installed):
                continue   # dpkg's own dirs change with any package, the entries in them are checked on their own
            if not ok:
                reasons.append(f"owner not upgraded since the last accept, or installed from no repo ({', '.join(sorted(who)[:3])}): {p}")
            elif not isdir:
                packages.update(ok)   # a removed file that is still owned shows up as missing in the verify
            # a changed dir needs an upgraded owner, its entries are in the report on their own

    if not packages and not db_seen and not reasons:
        reasons.append("every path is ignored or a directory, no package to verify")
    for pkg in sorted(packages):
        bad = pm.clean(pkg)
        if bad:
            reasons.append(f"{pkg} doesn't verify clean: {bad}")
    out(True, total)


if __name__ == "__main__":
    main()
