# managed by ansible (roles/aide). login-home rules + churn excludes on top of debian's rules.
{% for h in aide_login_homes %}
{{ h }}$ d VarDir
{{ h }}/{{ aide_history_files }}$ f VarFile
{% endfor %}
{% for p in aide_excludes_common %}
!{{ p }}(/|$)
{% endfor %}
{% for g in group_names if g in aide_excludes_by_group %}
{% for p in aide_excludes_by_group[g] | flatten %}
!{{ p }}(/|$)
{% endfor %}
{% endfor %}
