---
# template for the encrypted vault. copy the keys into vault.yml:
#   ansible-vault edit ansible/group_vars/all/vault.yml
# non-secret facts live in the other files here, not in the vault.

sudo_pass: "CHANGE_ME"
cf_token: "CHANGE_ME"

# ntfy phone alerts (pbs, login-notify, aide). url includes the topic; token optional
ntfy_url: "https://ntfy.sh/CHANGE_ME"
ntfy_token: ""

authentik_pg: "CHANGE_ME"
authentik_key: "CHANGE_ME"

vw_admin: "CHANGE_ME"
vw_sso_id: "CHANGE_ME"
vw_sso_secret: "CHANGE_ME"

gitea_admin_user: "CHANGE_ME"
gitea_admin_email: "you@example.org"
gitea_admin_pass: "CHANGE_ME"

grafana_pass: "CHANGE_ME"
grafana_oidc_id: "CHANGE_ME"
grafana_oidc_secret: "CHANGE_ME"

actual_oidc_id: "CHANGE_ME"
actual_oidc_secret: "CHANGE_ME"
linkding_oidc_id: "CHANGE_ME"
linkding_oidc_secret: "CHANGE_ME"

searxng_secret: "CHANGE_ME"

nextcloud_admin_pass: "CHANGE_ME"
nextcloud_db_pass: "CHANGE_ME"

immich_db_pass: "CHANGE_ME"   # alphanumeric only, immich rejects specials

paperless_admin_pass: "CHANGE_ME"
paperless_db_pass: "CHANGE_ME"
paperless_secret_key: "CHANGE_ME"
paperless_oidc_id: "CHANGE_ME"
paperless_oidc_secret: "CHANGE_ME"

proxmox_secret: "CHANGE_ME"
pbs_homepage_token: "CHANGE_ME"
homepage_ha_token: "CHANGE_ME"   # ha long-lived token, the haos tile reads system monitor sensors

# pbs backup client (roles/pbs): token secret + datastore cert fingerprint
pbs_token_secret: "CHANGE_ME"
pbs_fingerprint: "CHANGE_ME"

vault_netbird_setup_key: "CHANGE_ME"

# nixos vms' /var/lib/secrets (playbooks/nixos-secrets.yml). cloudflare.env takes cf_token, aide's ntfy.env ntfy_url/ntfy_token
# store key: openssl rand -base64 32 on a fresh lab, else the live one (the netbird store is encrypted with it)
vault_nixos_netbird_datastore_key: "CHANGE_ME"
vault_nixos_netbird_idp_password: "CHANGE_ME"   # unused while IdpManagerConfig is off, the file has to exist
vault_nixos_netbird_turn_secret: "CHANGE_ME"
vault_nixos_netbird_turn_password: "CHANGE_ME"   # coturn's long-term credential

# semaphore on ctl-1 (apps/semaphore). key: head -c32 /dev/urandom | base64, losing it locks the key store
semaphore_admin_pass: "CHANGE_ME"
semaphore_key_encryption: "CHANGE_ME"
semaphore_oidc_id: "CHANGE_ME"
semaphore_oidc_secret: "CHANGE_ME"
# api token of the guest-role semaphore user gatus reads the last runs with
semaphore_gatus_token: "CHANGE_ME"
# bearer token the backups and semaphore runs push their heartbeats to gatus with (any long random string)
gatus_push_token: ""

# the one mqtt user every sensor and consumer logs in with (mqtt_user in app_settings.yml).
# one line; roles/mqtt_exporter escapes backslash, quote, backtick, dollar for systemd. it's also in the firmware
mqtt_password: "CHANGE_ME"
# salt for the change-detection checksum of mqtt_password (roles/mosquitto), any random string
mqtt_passwd_salt: "CHANGE_ME"

wifi_ssid: "your-ssid"
wifi_pass: "CHANGE_ME"

# samba users (samba_shares in storage.yml). admin = full access, rest scoped
smb_passwords:
  admin: "CHANGE_ME"
  backup: "CHANGE_ME"
  pve: "CHANGE_ME"
  media: "CHANGE_ME"
  nextcloud: "CHANGE_ME"
  paperless: "CHANGE_ME"
  immich: "CHANGE_ME"
