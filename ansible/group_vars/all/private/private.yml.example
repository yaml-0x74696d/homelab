---
# per-lab values, kept out of git: cp private.yml.example private.yml and fill in.
# ansible loads it with the rest of group_vars/all, tofu reads it in locals.tf, the nix flake
# gets this dir as its `private` input. nothing secret here, secrets go in vault.yml.
domain: example.org
admin_user: admin              # login user on every host + app admin accounts
# outside the repo: apps/<name>/config/ in here lays over the public config (nginx site, own images). unset = none
private_dir: ~/homelab-private

# admin key on the nixos boxes (ansible hosts + tofu use admin_ssh_pubkey_file instead)
admin_ssh_pubkeys:
  - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA_CHANGE_ME admin@controller"

# nic macs, they pin the dhcp leases. samples = proxmox prefix BC:24:11 + the vmid.
macs:
  docker-1: { lan: "BC:24:11:00:02:01" }
  docker-2: { lan: "BC:24:11:00:02:02" }
  docker-3: { lan: "BC:24:11:00:02:03" }
  netbird: { lan: "BC:24:11:00:02:50" }   # nixos matches the nic by it
  haos: { lan: "BC:24:11:00:02:10" }   # the fritz!box pins haos_ip to it
  storage: { lan: "BC:24:11:00:03:00" }
  log: { lan: "BC:24:11:00:03:01" }
  iot: { lan: "BC:24:11:00:03:02" }

# ext4 disks unioned into the pool (blkid on pve-3)
storage_disks:
  - { path: /mnt/storage/disk1, uuid: "CHANGE_ME-disk1-uuid" }
  - { path: /mnt/storage/disk2, uuid: "CHANGE_ME-disk2-uuid" }
  - { path: /mnt/storage/disk3, uuid: "CHANGE_ME-disk3-uuid" }
  - { path: /mnt/storage/disk4, uuid: "CHANGE_ME-disk4-uuid" }

# authentik public client netbird logs in with (audience == client id), not a secret
netbird_oidc_client_id: "CHANGE_ME-authentik-client-id"

# devices that may ssh to the pve nodes and open the pve ui
admin_hosts:
  - { ip: 192.168.178.2, c: controller }
# extra devices for the pve ui only (no ssh)
admin_ui_hosts: []
